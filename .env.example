# Guided mode needs no external credentials.
# For local Wrangler/Vinext, copy these into ignored .dev.vars.
# For hosting, configure secret values in the host environment.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK=
# Choose a Converse-capable model that your AWS account can actually access.
# Never commit a real key or put it in a NEXT_PUBLIC_ variable.
